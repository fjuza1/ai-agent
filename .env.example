LLM_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=
MONTHLY_BUDGET_USD=1000
STICKER_APP_URL=http://localhost:3000
SUPPLEMENT_APP_URL=http://localhost:3001
INDEXNOW_ENABLED=false
INDEXNOW_HOST=
INDEXNOW_KEY=
TREND_FEED_URL=
PRODUCT_DISCOVERY_FEED_URL=
AFFILIATE_TAG_AMAZON=
# Optional single name=value tracking parameter appended to generated Alza.sk search links, e.g. idp=12345.
ALZA_AFFILIATE_PARAM=
AFFILIATE_TAG_DIRECT=
STRIPE_STICKER_OVERAGE_PRICE_CENTS=2
DAILY_FREE_STICKER_LIMIT=20
RESEND_API_KEY=
GIFT_EMAIL_FROM=
# HMAC key for gift-email unsubscribe links (16+ characters); falls back to AUTH_SECRET.
GIFT_UNSUBSCRIBE_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_SUPPORT_TO_EMAIL=
# Dedicated IP pool must exist in the SendGrid account.
SENDGRID_IP_POOL=
# Auth.js signing secret (generate with: npx auth secret). Also signs email click-tracking links; 16+ characters.
AUTH_SECRET=
# Canonical public URL of the supplement storefront; recommended in production so magic links never use a request Host header.
AUTH_URL=
# SQLite file for supplement accounts, favorites and engagement logs (relative to apps/usa-christmas-supplements/prisma).
# sticker-market reads the same variable for its own database; use absolute paths on persistent disks in production.
# connection_limit=1 and socket_timeout avoid SQLITE_BUSY errors from concurrent writers.
DATABASE_URL="file:./dev.db?connection_limit=1&socket_timeout=10"
# Bearer token required by /api/cron/send-product-alerts (also add it as a GitHub Actions secret).
CRON_SECRET=
# Optional absolute paths; defaults are the monorepo data directory.
SUPPLEMENT_CATALOG_PATH=
AFFILIATE_CLICK_LOG=
