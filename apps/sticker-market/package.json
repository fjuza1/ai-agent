{
  "name": "sticker-market",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "test:integration": "node --test tests/webhook.test.cjs tests/giftEmail.test.cjs",
    "db:generate": "node --env-file-if-exists=../../.env scripts/prisma.mjs generate",
    "db:push": "node --env-file-if-exists=../../.env scripts/prisma.mjs db push"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@sendgrid/mail": "^8.1.6",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^20.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "prisma": "6.12.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  }
}
